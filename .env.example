# ARTHA V1 Environment Configuration Template

# General Settings
ENV=development
LOG_LEVEL=INFO

# Database Settings
SQLITE_DB_PATH=data/market.db

# Broker Settings (OpenAlgo / Others)
OPENALGO_API_KEY=your-openalgo-key-here
OPENALGO_API_URL=http://localhost:5000

# Risk Settings
MAX_PORTFOLIO_DRAWDOWN=0.05
MAX_POSITION_SIZE_KELLY_FRACTION=0.5
